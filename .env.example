# ============================================================================
# SyberInfo — environment variables. Copy to `.env.local` (dev) or set these in
# your process manager / hosting environment (prod). Nothing here is committed.
# ============================================================================

# --- Payload CMS (required) --------------------------------------------------
# Long random string used to sign auth tokens. Generate: openssl rand -base64 32
# The app refuses to start in production if this is unset or left as the default.
PAYLOAD_SECRET=change-me-to-a-long-random-string
# SQLite database location. Use an ABSOLUTE path in production.
DATABASE_URI=file:./syberinfo.db

# --- Site / deployment -------------------------------------------------------
# Public site URL. Used for CORS/CSRF allowlists, password-reset links, canonical URLs.
SITE_URL=https://syberinfo.com.au
# Set to "false" ONLY if the app is exposed directly (not behind nginx/Cloudflare);
# when true (default) the rate limiter trusts X-Forwarded-For.
TRUST_PROXY=true
# Serve under a sub-path (rarely needed). Leave unset for domain root.
# BASE_PATH=/app
# Relocate uploaded media (defaults to ./media).
# MEDIA_DIR=/absolute/path/to/media

# --- Email (Resend) ----------------------------------------------------------
# Enables the contact form email, password-reset + ticket notifications.
# Without it, those are logged to the server console instead of sent.
RESEND_API_KEY=
# From/notify addresses.
CONTACT_FROM_ADDRESS=noreply@syberinfo.com.au
CONTACT_FROM_NAME=SyberInfo
CONTACT_FROM="SyberInfo <noreply@syberinfo.com.au>"
CONTACT_TO=hello@syberinfo.com.au

# --- Spam protection (Cloudflare Turnstile, optional) ------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics (optional) ----------------------------------------------------
NEXT_PUBLIC_GA_ID=

# --- Newsletter (Klaviyo, optional) ------------------------------------------
KLAVIYO_API_KEY=
KLAVIYO_LIST_ID=

# --- SEO audit tool (Google PageSpeed, optional) -----------------------------
PAGESPEED_API_KEY=

# --- Payments (Stripe, optional) ---------------------------------------------
# When set, the portal can create checkout sessions and receive webhooks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Ingram Micro Cloud "Marketplace API" (CMP) (optional) -------------------
# When set, /api/admin/ingram-sync syncs the distributor catalogue into the
# `software` collection and orders can be pushed for provisioning.
#
# Auth mode: "cmp" (default) uses the CMP gateway token flow described in the
# Xvantage guide (Basic auth to {base}/token + X-Subscription-Key + marketplace
# body). Set to "oauth" to use the OAuth2 client-credentials endpoint instead.
INGRAM_AUTH_MODE=cmp
# CMP username / password (a.k.a. client id / secret). NEVER commit real values.
INGRAM_CLIENT_ID=
INGRAM_CLIENT_SECRET=
# From your developer-portal API subscription ("SimpleAPI") page:
#   INGRAM_BASE_URL        the exact request/base URL shown there (host + base path)
#   INGRAM_SUBSCRIPTION_KEY the subscription/primary key (sent as X-Subscription-Key)
INGRAM_BASE_URL=
INGRAM_SUBSCRIPTION_KEY=
# Marketplace region code sent in the CMP token request body (e.g. au, us, gb).
INGRAM_MARKETPLACE=au
# Only used when INGRAM_AUTH_MODE=oauth:
INGRAM_TOKEN_URL=https://api.ingrammicro.com/oauth/oauth20/token

# --- Booking (optional) ------------------------------------------------------
# When set, /book embeds this external scheduler (Cal.com, Calendly, Google
# Appointments, …) so calls land straight in the team calendar. Leave unset to
# use the built-in day/time picker. Must be an embeddable URL.
NEXT_PUBLIC_BOOKING_URL=

# --- Scheduled billing run (recurring billing + dunning) ---------------------
# Secret bearer token that lets an external scheduler trigger the daily billing
# cycle: POST /api/admin/billing-run with header  Authorization: Bearer <token>.
# Generate: openssl rand -hex 32. A logged-in admin can also run it from the UI.
CRON_SECRET=

# --- Demo data (development only) --------------------------------------------
# Set to "true" to seed a demo customer + billing data for the portal.
# SEED_DEMO=true
